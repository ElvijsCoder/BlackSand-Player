<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 (B · Nameplate): counter + light, title, dot progress, then round keys with a big PLAY. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_flat"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/cassette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <Chronometer
                    android:id="@+id/elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/doto"
                    android:includeFontPadding="false"
                    android:textColor="#F2F2F0"
                    android:textSize="26sp" />
                <TextView
                    android:id="@+id/elapsed_still"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/doto"
                    android:includeFontPadding="false"
                    android:textColor="#F2F2F0"
                    android:textSize="26sp" />
            </FrameLayout>
            <ImageView
                android:id="@+id/led"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:contentDescription="@null"
                android:src="@drawable/led_off" />
        </LinearLayout>
        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_grotesk"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/widget_idle_title"
            android:textColor="#F2F2F0"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progressDrawable="@drawable/dot_progress" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/key_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/round_key"
            android:contentDescription="Previous"
            android:scaleType="center"
            android:src="@drawable/glyph_prev" />
        <ImageView
            android:id="@+id/key_play"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/round_key_main"
            android:contentDescription="Play or pause"
            android:scaleType="center"
            android:src="@drawable/glyph_playpause_ink" />
        <ImageView
            android:id="@+id/key_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/round_key"
            android:contentDescription="Next"
            android:scaleType="center"
            android:src="@drawable/glyph_next" />
    </LinearLayout>
</LinearLayout>
