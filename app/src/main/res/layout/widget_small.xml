<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: the cassette with art, title and reels, plus three keys. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/cassette"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/cassette_shell"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cassette_label"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/art_placeholder"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/widget_idle_title"
                        android:textColor="#111111"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_mono_regular"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="#444444"
                        android:textSize="8sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/led"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/led_off" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:background="@drawable/tape_window"
                android:minHeight="24dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start|center_vertical">
                    <ImageView
                        android:id="@+id/pack_left"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/tape_pack" />
                    <ImageView
                        android:id="@+id/hub_left"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:rotation="20"
                        android:src="@drawable/reel_hub" />
                    <ProgressBar
                        android:id="@+id/spin_left"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/reel_hub_spin"
                        android:indeterminateDuration="1600"
                        android:indeterminateOnly="true"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical">
                    <ImageView
                        android:id="@+id/pack_right"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/tape_pack" />
                    <ImageView
                        android:id="@+id/hub_right"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:rotation="75"
                        android:src="@drawable/reel_hub" />
                    <ProgressBar
                        android:id="@+id/spin_right"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/reel_hub_spin"
                        android:indeterminateDuration="1300"
                        android:indeterminateOnly="true"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/key_recess"
        android:orientation="horizontal"
        android:padding="3dp">

        <FrameLayout
            android:id="@+id/key_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/widget_prev">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:contentDescription="@null"
                android:src="@drawable/glyph_prev" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/widget_play">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:contentDescription="@null"
                android:src="@drawable/glyph_playpause" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/key_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="@string/widget_next">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="2dp"
                android:contentDescription="@null"
                android:src="@drawable/glyph_next" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
