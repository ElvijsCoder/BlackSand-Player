<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 (A · Tape window): song + light + count, the tape window with turning reels and the
     counter between them, then three deck keys. Tap the top part to open the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_flat"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/cassette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/widget_idle_title"
                android:textColor="#F2F2F0"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="@font/space_grotesk"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#8A8A8A"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/led"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/led_off" />
        <TextView
            android:id="@+id/track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/space_mono_regular"
            android:includeFontPadding="false"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/tape_window_flat"
        android:minHeight="56dp">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginStart="20dp">
            <ImageView
                android:id="@+id/pack_left"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/tape_pack" />
            <ImageView
                android:id="@+id/hub_left"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:rotation="20"
                android:src="@drawable/reel_hub" />
            <ProgressBar
                android:id="@+id/spin_left"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/reel_hub_spin"
                android:indeterminateDuration="1600"
                android:indeterminateOnly="true"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <Chronometer
                android:id="@+id/elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/doto"
                android:includeFontPadding="false"
                android:textColor="#F2F2F0"
                android:textSize="22sp" />
            <!-- Shown while paused: a stopped Chronometer recounts from its base on every redraw. -->
            <TextView
                android:id="@+id/elapsed_still"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/doto"
                android:includeFontPadding="false"
                android:textColor="#F2F2F0"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/space_mono_regular"
                android:includeFontPadding="false"
                android:textColor="#8A8A8A"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginEnd="20dp">
            <ImageView
                android:id="@+id/pack_right"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/tape_pack" />
            <ImageView
                android:id="@+id/hub_right"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:rotation="75"
                android:src="@drawable/reel_hub" />
            <ProgressBar
                android:id="@+id/spin_right"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/reel_hub_spin"
                android:indeterminateDuration="1300"
                android:indeterminateOnly="true"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/key_prev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="Previous"
            android:scaleType="center"
            android:src="@drawable/glyph_prev" />
        <ImageView
            android:id="@+id/key_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="Play or pause"
            android:scaleType="center"
            android:src="@drawable/glyph_playpause" />
        <ImageView
            android:id="@+id/key_next"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/key_bg"
            android:contentDescription="Next"
            android:scaleType="center"
            android:src="@drawable/glyph_next" />
    </LinearLayout>
</LinearLayout>
