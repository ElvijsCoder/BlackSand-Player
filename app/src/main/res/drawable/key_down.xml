<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed key: sunk into the housing, so only a sliver of the front edge shows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3.5dp"><shape><solid android:color="#070707" /><corners android:radius="6dp" /></shape></item>
    <item android:top="3.5dp" android:bottom="1.5dp">
        <shape>
            <gradient android:angle="270" android:startColor="#202020" android:endColor="#181818" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
